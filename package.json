{
  "name": "zmrig",
  "version": "6.32.1",
  "description": "ZMRIG - RandomX miner with 0% developer fee, by @nggkhaiz",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "build": "node scripts/generate_cl.js",
    "test": "node run_tests.js",
    "test:web": "node --test legacy/tests/*.test.js",
    "test:pool": "node --test pool/tests/*.test.js",
    "test:oneclick": "bash tests/oneclick/plan.sh && bash tests/oneclick/config.sh && bash tests/oneclick/governor.sh && bash tests/oneclick/purge.sh",
    "test:docs": "bash tests/docs/links.sh",
    "test:pages": "bash tests/docs/pages.sh",
    "build:site": "cd site && npm run build",
    "publish:site": "bash scripts/publish-site.sh",
    "test:site": "cd site && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NggKhaiz/ZMRIG.git"
  },
  "keywords": [
    "monero",
    "randomx",
    "miner",
    "pool",
    "zig",
    "gpl-3.0"
  ],
  "author": "@nggkhaiz (https://github.com/NggKhaiz)",
  "license": "GPLv3",
  "bugs": {
    "url": "https://github.com/NggKhaiz/ZMRIG/issues"
  },
  "homepage": "https://nggkhaiz.github.io/ZMRIG/",
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
